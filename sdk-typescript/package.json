{
  "name": "@openelevo/workspace-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for Elevo Workspace Service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "echo 'No tests specified'",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
