# Elevo Workspace - Production Environment Configuration
# Copy this file to .env and modify as needed:
#   cp .env.example .env

# ============================================================
# Image Configuration
# ============================================================

# Server image
ELEVO_IMAGE=ghcr.io/openelevo/elevosandbox-server
ELEVO_VERSION=v0.3.0

# Base image for sandbox containers
ELEVO_BASE_IMAGE=ghcr.io/openelevo/elevosandbox-base
ELEVO_BASE_VERSION=v0.3.0

# ============================================================
# Network Configuration
# ============================================================

# HTTP API port
HTTP_PORT=8080

# gRPC port (agent communication)
GRPC_PORT=9090

# ============================================================
# Storage Configuration
# ============================================================

# Host path for workspace files (sandbox containers mount from here)
# MUST be an absolute path on the host machine
WORKSPACE_HOST_DIR=/var/lib/elevo-workspace/workspaces

# ============================================================
# Runtime Configuration
# ============================================================

# Log level: error, warn, info, debug, trace
RUST_LOG=info,workspace_server=info

# Agent connection timeout (seconds)
AGENT_TIMEOUT=60

# Max idle time before sandbox auto-stop (seconds)
MAX_IDLE_TIME=7200

# MCP mode: disabled, embedded
MCP_MODE=disabled
